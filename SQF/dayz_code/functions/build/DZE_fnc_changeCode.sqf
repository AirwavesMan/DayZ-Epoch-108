///////////////////////////////////////////////////////////////////////////////////////////////////
//
//	DZE_fnc_changeCode
//
//	Author:		salival
//	Updated by:	Airwaves Man
//
//	Description:	Changes a storage or door code while preserving the model-center worldspace.
//	Groups:		Build
//
//	Syntax:		Executed by an addAction entry with the target object in _this select 3
//
//	Parameters:	target: Object - Object to which the action is attached
//			caller: Object - Unit executing the action
//			actionId: Number - addAction identifier
//			object: Object - Storage or door whose code is changed
//
//	Return Value:	Nothing
//
//	Called by:	Client
//
///////////////////////////////////////////////////////////////////////////////////////////////////

//#define DEBUG_DZE_FNC_CHANGE_CODE

#ifdef DEBUG_DZE_FNC_CHANGE_CODE
	diag_log format ['[Client Debug]: [DZE_fnc_changeCode]: Function called with argumentes: %1',_this];
#endif

if (dayz_actionInProgress) exitWith {localize 'STR_BUILD_CHANGE_CODE_ALREADY_IN_PROGRESS' call DZE_fnc_rollingMessages;};
dayz_actionInProgress = true;

local _object = if (typeName _this == 'ARRAY' && {count _this > 3}) then {_this select 3} else {objNull};

if (typeName _this != 'ARRAY' || {count _this < 4}) exitWith {
	dayz_actionInProgress = false;
	#ifdef DEBUG_DZE_FNC_CHANGE_CODE
		diag_log format ['[Client Debug]: [DZE_fnc_changeCode]: Error: Invalid action parameters: %1',_this];
	#endif
};

//	Object is null
if (isNull _object) exitWith {dayz_actionInProgress = false; systemChat localize 'STR_BUILD_CHANGE_CODE_OBJECT_NOT_FOUND';};

local _typeOf = typeOf _object;
local _isSafe = _typeOf in ['DZE_Safe','DZE_Safe2','DZE_SafeTall'];
local _isLockBox = _typeOf in DZE_LockboxesUnlocked;
local _isStorage = _isSafe || _isLockBox;
local _isDoor = _typeOf in DZE_DoorsLocked;

if (!_isStorage && !_isDoor) exitWith {
	dayz_actionInProgress = false;

	diag_log format ['[Client Debug]: [DZE_fnc_changeCode]: Warning: Unsupported object type: %1',_typeOf];
};

local _oldCode = _object getVariable ['CharacterID','0'];

//	Do not allow change code of objects with a bad code, bad codes can be generated by the reset safe event
if (!DZE_changeBadCodes && {_oldCode in DZE_badCodes}) exitWith {
	dayz_actionInProgress = false;
	systemChat localize 'STR_BUILD_CHANGE_CODE_REBUILD_REQUIRED';

	#ifdef DEBUG_DZE_FNC_CHANGE_CODE
		diag_log format ['[Client Debug]: [DZE_fnc_changeCode]: Old Code: %1 in Bad Codes Array: %2',_oldCode,DZE_badCodes];
	#endif
};

local _backupCode = '';
local _badCode = false;
local _lockCode = '';

local _dialog = call {
	if (_isLockBox) exitWith {'KeyPadUI'};
	if (_isSafe) exitWith {'SafeKeyPad'};
	if (_isDoor) exitWith {'ComboLockUI'};
	''
};

if (_dialog == '') exitWith {
	dayz_actionInProgress = false;
	#ifdef DEBUG_DZE_FNC_CHANGE_CODE
		diag_log format ['[Client Debug]: [DZE_fnc_changeCode]: Error: No supported dialog found for object type: %1',_typeOf];
	#endif
};

if (_isStorage) then {
	_backupCode = dayz_combination;
	dayz_combination = '';
	dayz_selectedVault = objNull;
} else {
	DZE_topCombo = 0;
	DZE_midCombo = 0;
	DZE_botCombo = 0;
	_backupCode = DZE_Lock_Door;
	DZE_Lock_Door = '';
	dayz_selectedDoor = objNull;
};

createDialog _dialog;

waitUntil {uiSleep 0.1; !dialog};

if (keypadCancel) exitWith {
	dayz_actionInProgress = false;
	if (_isStorage) then {dayz_combination = _backupCode;} else {DZE_Lock_Door = _backupCode;};
};

if (_isStorage) then {
	if (_isSafe) then {
		if ((parseNumber dayz_combination) > 9999 || count (toArray (dayz_combination)) < 4) then {_badCode = true;};
	} else {
		_lockCode = dayz_combination call fnc_lockCode;
		if (typeName _lockCode == 'SCALAR') then {_badCode = true;};
	};
} else {
	if (parseNumber DZE_Lock_Door == 0) then {_badCode = true};
};

if (_badCode) exitWith {
	dayz_actionInProgress = false;
	if (_isStorage) then {dayz_combination = _backupCode;} else {DZE_Lock_Door = _backupCode;};
	systemChat localize 'STR_BUILD_CHANGE_CODE_INVALID';
};

local _newCode = [DZE_Lock_Door,dayz_combination] select _isStorage;

//	New code is not valid since it is in the bad code array
if (_newCode in DZE_badCodes) exitWith {
	dayz_actionInProgress = false;
	if (_isStorage) then {dayz_combination = _backupCode;} else {DZE_Lock_Door = _backupCode;};
	systemChat format [localize 'STR_BUILD_CHANGE_CODE_NOT_ALLOWED',[_newCode,_lockCode] select _isLockBox];
};

//	New code is the same code than before
if (_oldCode == _newCode) exitWith {
	dayz_actionInProgress = false;
	if (_isStorage) then {dayz_combination = _backupCode;} else {DZE_Lock_Door = _backupCode;};
	systemChat localize 'STR_BUILD_CHANGE_CODE_INVALID';
};

DZE_Wait_For_Object = nil;
PVDZE_changeCode = [netId player,netId _object,_newCode,dayz_authKey];
publicVariableServer 'PVDZE_changeCode';

local _newObject = call DZE_fnc_revealServerObject;

if (isNull _newObject) then {
	if (_isStorage) then {dayz_combination = _backupCode;} else {DZE_Lock_Door = _backupCode;};
	systemChat localize 'STR_BUILD_CHANGE_CODE_FAILED';
} else {
	systemChat format [localize 'STR_BUILD_CHANGE_CODE_CHANGED',if (_isStorage) then {if (_isSafe) then {dayz_combination} else {dayz_combination call fnc_lockCode}} else {DZE_Lock_Door}];
};
dayz_actionInProgress = false;
